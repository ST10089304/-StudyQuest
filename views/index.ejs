<%- include('partials/header') %>
<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">Academic progress, redesigned</p>
    <h1>Turn your study goals into completed quests.</h1>
    <p class="hero-text">Organise assignments, prioritise deadlines, earn points and unlock achievement badges from one focused dashboard.</p>
    <div class="hero-actions">
      <a class="button" href="/register">Start your quest</a>
      <a class="text-link" href="/login">I already have an account</a>
    </div>
  </div>
  <div class="hero-visual">
    <div class="orb orb-one"></div>
    <div class="orb orb-two"></div>
    <div class="mock-dashboard">
      <div class="mock-top"><span>Weekly progress</span><strong>72%</strong></div>
      <div class="progress"><span style="width:72%"></span></div>
      <div class="mock-task"><span class="task-dot high"></span><div><strong>Database assignment</strong><small>Due Friday</small></div></div>
      <div class="mock-task"><span class="task-dot medium"></span><div><strong>Revise JavaScript</strong><small>Due Monday</small></div></div>
      <div class="badge-pill">First Task Completed</div>
    </div>
  </div>
</section>

<section class="feature-band">
  <p>Personal dashboard</p><p>Secure authentication</p><p>Points and badges</p>
</section>

<section class="section">
  <div class="section-heading">
    <p class="eyebrow">Your new study system</p>
    <h2>Everything needed to stay ahead.</h2>
  </div>
  <div class="feature-grid">
    <article class="feature-card"><span>01</span><h3>Capture every task</h3><p>Add assignment details, priorities and due dates before they become stressful.</p></article>
    <article class="feature-card featured"><span>02</span><h3>See real progress</h3><p>Track open, completed and overdue work through clear dashboard statistics.</p></article>
    <article class="feature-card"><span>03</span><h3>Earn achievements</h3><p>Receive points for completed work and unlock badges as your consistency grows.</p></article>
  </div>
</section>

<section class="cta-panel">
